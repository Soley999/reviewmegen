PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=200

# ── AI Providers ────────────────────────────────────────────────────────────
# Primary: Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fallback: Groq (fast, free tier available)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
# Model names — use the full "models/..." prefix as returned by the ListModels API.
# Run: node list-models.mjs  to see all models your key can access.
GEMINI_MODEL=models/gemini-3.5-flash
GROQ_MODEL=qwen/qwen3.8-27b

# ── Chunking (advanced) ─────────────────────────────────────────────────────
# Max characters sent per AI call. Large files are split into chunks of this size.
# Default 60000 chars (~15K tokens) — safe for all models.
MAX_CHARS_PER_CHUNK=60000
